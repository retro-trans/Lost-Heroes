  {
   "key": "MainEventMess0659.mbb#0.125",
   "note": "Gaga shout 'Trans-Am' (glossary UI term) as a plain shout, not a device voice line; no prior English precedent found."
  },
  {
   "key": "MainEventMess0659.mbb#0.134",
   "note": "Ankh, cut off as the Gaga ram the party."
  },
  {
   "key": "MainEventMess0659.mbb#0.138",
   "note": "#0.138-152: 15-row leader damage-cry block; each distinct cry rendered distinctly, #0.151 = #0.142 identical JP -> identical EN."
  },
  {
   "key": "MainEventMess0659.mbb#0.153",
   "note": "Gijitaiyouro = GN Drive Tau (glossary); tokkou heiki = suicide-attack (kamikaze) weapons."
  },
  {
   "key": "MainEventMess0659.mbb#0.154",
   "note": "Arche urging the Gaga on ('jan-jan ike')."
  },
  {
   "key": "MainEventMess0659.mbb#0.158",
