  },
  {
   "key": "MainEventMess0659.mbb#0.176",
   "note": "Taishou (Arche's word for Reborns) = 'Boss'."
  },
  {
   "key": "MainEventMess0659.mbb#0.177",
   "note": "'Three rats' = the party's allies elsewhere (Seravee and others, per #0.179 block); 'sakimawari shite shimatsu' = get there first and dispose of them."
  },
  {
   "key": "MainEventMess0659.mbb#0.179",
   "note": "#0.179-193: 15 leader copies. #0.184/#0.188 use rough 'abunee' -> 'in big trouble'. #0.185/#0.186 add '-san' (polite leaders); -san dropped per style, so identical EN to the plain variant."
  },
  {
   "key": "MainEventMess0659.mbb#0.199",
   "note": "'Ore no deru maku ga nee' = no part left for me to play (he needn't step in himself)."
  },
  {
   "key": "MainEventMess0659.mbb#0.204",
