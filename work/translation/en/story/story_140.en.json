 "rows": [
  {
   "key": "MainEventMess0662.mbb#0.36",
   "en": "Our... Our comrades are...!"
  },
  {
   "key": "MainEventMess0662.mbb#0.37",
   "en": "...!!!!"
  },
  {
   "key": "MainEventMess0662.mbb#0.38",
   "en": "At that moment, 00 heard the voices of his comrades..."
  },
  {
   "key": "MainEventMess0662.mbb#0.40",
   "en": "Not in a place like this...!!"
  },
  {
   "key": "MainEventMess0662.mbb#0.41",
   "en": "Tch! I'm out of ammo...!"
  },
  {
   "key": "MainEventMess0662.mbb#0.42",
   "en": "What are we supposed to do...!!"
  },
  {
   "key": "MainEventMess0662.mbb#0.44",
   "en": "Heavyarms! Birth! Sandrock!"
  },
  {
   "key": "MainEventMess0662.mbb#0.47",
   "en": "Do me a favor and vanish from this world, Gundam!!"
  },
  {
   "key": "MainEventMess0662.mbb#0.48",
   "en": "Dammit... but I ain't goin' down for nothing... ...You're coming to hell with me, pal!!!"
  },
  {
   "key": "MainEventMess0662.mbb#0.50",
   "en": "Deathscythe!!"
  },
  {
   "key": "MainEventMess0662.mbb#0.54",
   "en": "..."
  },
  {
   "key": "MainEventMess0662.mbb#0.55",
   "en": "Uwaaagh!! ...Is this where it ends!?"
  },
  {
   "key": "MainEventMess0662.mbb#0.56",
   "en": "Arios!!"
  },
  {
   "key": "MainEventMess0662.mbb#0.59",
   "en": "Everyone's lives..."
  },
  {
   "key": "MainEventMess0662.mbb#0.60",
   "en": "...are fading away..."
  },
  {
   "key": "MainEventMess0662.mbb#0.63",
   "en": "..."
  },
  {
   "key": "MainEventMess0662.mbb#0.64",
   "en": "Gwaagh!! ...You son of a biiitch!!"
  },
  {
   "key": "MainEventMess0662.mbb#0.68",
   "en": "I won't..."
  },
  {
   "key": "MainEventMess0662.mbb#0.69",
   "en": "...let that haaaaaaappen!!"
  },
  {
   "key": "MainEventMess0662.mbb#0.70",
   "en": "A massive burst of GN particles erupted from 00's body!!"
  },
  {
   "key": "MainEventMess0662.mbb#0.71",
   "en": "Wh-What are these GN particles...!!"
  },
  {
   "key": "MainEventMess0662.mbb#0.72",
   "en": "They're scrambling my quantum brainwaves...!!"
  },
  {
   "key": "MainEventMess0662.mbb#0.73",
   "en": "Uoooooooooooooooh!!"
  },
  {
   "key": "MainEventMess0662.mbb#0.74",
   "en": "...I've been waiting for this moment."
  },
  {
   "key": "MainEventMess0662.mbb#0.75",
   "en": "...Reborns Gundam. I won't let you have your way."
  },
  {
   "key": "MainEventMess0662.mbb#0.77",
   "en": "Seravee...!? Don't tell me you've taken the system!!"
  },
  {
   "key": "MainEventMess0662.mbb#0.78",
   "en": "What's going on...? Seravee, you're alive?"
  },
  {
   "key": "MainEventMess0662.mbb#0.79",
   "en": "Don't go killing me off on your own say-so. My consciousness is now fully linked with Veda."
  },
  {
   "key": "MainEventMess0662.mbb#0.80",
   "en": "Now's our chance to take down Reborns!!"
  },
  {
   "key": "MainEventMess0662.mbb#0.81",
   "en": "...Ngh, Veda has gone over to Seravee!! But I haven't lost yet!!"
  },
  {
   "key": "MainEventMess0662.mbb#0.82",
   "en": "...!! Reborns!!"
  },
  {
   "key": "MainEventMess0662.mbb#0.83",
   "en": "After him!! Go after him!!"
  },
  {
   "key": "MainEventMess0663.mbb#0.1",
   "en": "Wait, take a left there...!!"
  },
  {
   "key": "MainEventMess0663.mbb#0.3",
   "en": "Now, go!!"
  },
  {
   "key": "MainEventMess0663.mbb#0.4",
   "en": "Seravee...!?"
