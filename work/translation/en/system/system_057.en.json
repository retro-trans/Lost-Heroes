 "rows": [
  {
   "key": "Table/GameOver/GameOverMess.mbb#1.3",
   "en": "On turns when it hits the whole party, Defend. It also targets Heroes with low HP, so be careful."
  },
  {
   "key": "Table/GameOver/GameOverMess.mbb#1.4",
   "en": "This enemy isn't all that strong. Stay calm and deal with it, using Skills to take it down."
  },
  {
   "key": "Table/GameOver/GameOverMess.mbb#1.5",
   "en": "They use combined attacks, so take one down first. Seagorath has low HP, so aim for it."
  },
  {
   "key": "Table/GameOver/GameOverMess.mbb#1.6",
   "en": "Moving on with low HP is dangerous. When in danger, use Return from Camp to go back to base."
  },
  {
   "key": "Table/GameOver/GameOverMess.mbb#1.7",
   "en": "Negataros hits the whole party on certain turns. Beat the fast, high-ATK Yummies first to make it easier."
  },
  {
   "key": "Table/GameOver/GameOverMess.mbb#1.8",
   "en": "Both seem to be weak to fire."
  },
  {
   "key": "Table/GameOver/GameOverMess.mbb#1.9",
   "en": "It seems to always use a party-wide attack on certain turns. It's not simple, but watch its actions closely."
  },
  {
   "key": "Table/GameOver/GameOverMess.mbb#1.10",
   "en": "Some enemies resist fire and other elements. One has slightly lower HP, so tell them apart and go for it."
  },
  {
   "key": "Table/GameOver/GameOverMess.mbb#1.11",
   "en": "Against many enemies, focus fire is the basic tactic. First, thin out their numbers."
  },
  {
   "key": "Table/GameOver/GameOverMess.mbb#1.12",
   "en": "It's powerful, but some of its attacks target the Hero with the highest HP. Read its timing and use Defend."
  },
  {
   "key": "Table/GameOver/GameOverMess.mbb#1.13",
   "en": "It often seems to go after the same Heroes. Read who it is aiming at and fight accordingly."
  },
  {
   "key": "Table/GameOver/GameOverMess.mbb#1.14",
   "en": "Restock your recovery items often."
  },
  {
   "key": "Table/GameOver/GameOverMess.mbb#1.15",
   "en": "Handle party-wide attacks by Defending. It's weak to certain elements, so it may be worth trying them out."
  },
  {
   "key": "Table/GameOver/GameOverMess.mbb#1.16",
   "en": "Spot enemies with low HP that are easy to down. Also prioritize enemies with high ATK."
  },
