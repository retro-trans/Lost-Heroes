 "rows": [
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.30",
   "en": "That's enough. Get out of here, now."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.31",
   "en": "Like I'd ever listen to anything you say!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.32",
   "en": "Don't get the wrong idea. I'm not asking."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.34",
   "en": "Daah!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.35",
   "en": "Listen. I'll say this just once more. Get out of my sight."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.36",
   "en": "Ngh! He's strong!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.37",
   "en": "Sempai, you okay?"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.38",
   "en": "What, Turtle!? I'm in the middle of a fight!! Don't talk to me!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.39",
   "en": "That won't cut it, Sempai. Scoot over a sec."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.41",
   "en": "What're you doin', Turtle!!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.42",
   "en": "I figured you couldn't win, Sempai. Hey you, how about you let me reel you in?"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.43",
   "en": "Hold it right there!! Leave this one to me!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.45",
   "en": "Hey, Kin-chan!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.46",
   "en": "I can't leave this to you lot. Leave it to me."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.47",
   "en": "No fair, Bear! Let me have a go too!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.49",
   "en": "I'm gonna beat you, okay? I don't care about your answer!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.50",
   "en": "Ryuta!! Don't you go jumpin' in on your own..."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.51",
   "en": "But everyone looks like they're having so much fun. Of course I'm joining in too♪"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.52",
   "en": "You snot-nosed brat! This ain't playtime!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.54",
   "en": "You bastards!! Is this some cute little playtime for the four of you!!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.56",
   "en": "Huh?"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.57",
   "en": "Den-O can now use a new skill."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.58",
   "en": "Oh!? What's this!?"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.59",
   "en": "No way... Sempai, looks like we've turned into Climax Form."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.60",
   "en": "Climax Form, ya say?"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.61",
   "en": "What? What the hell is going on?"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.62",
   "en": "Perfect timing!! I'll take ya on with this!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.63",
   "en": "Let's go, you guys!! From here on out, it's our climax!!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.66",
   "en": "Damn it... Next time, I'll devour every last one of you, for sure..."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.68",
   "en": "Heh! Serves you right!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.71",
   "en": "Completed the quest \"The Infamous Grand Bandit Gang\"."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess013.mbb#0.73",
   "en": "Den-O must be in the party to progress this quest."
  },
