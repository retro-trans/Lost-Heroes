{
 "slice": "quest_052",
 "rows_in_slice": 80,
 "rows_examined": 80,
 "rows": [
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.63",
   "en": "Don't worry about us. Hurry to Altron!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.64",
   "en": "We'll catch up with you later!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.65",
   "en": "Got it. I'll leave this to you."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.67",
   "en": "Hey! Wing Zero's not here!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.71",
   "en": "Puppets controlled by an evil will! I'll wipe out every last one of you myself!!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.73",
   "en": "Target acquired... Destroying it."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.74",
   "en": "You're... Wing Zero! What do you think you're doing!?"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.75",
   "en": "I came to help you... That's all."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.76",
   "en": "Help me, you say!? Don't get the wrong idea. We are not comrades!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.77",
   "en": "..."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.78",
   "en": "We don't have time to argue."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.79",
   "en": "Tch..."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.80",
   "en": "Target acquired... There!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.81",
   "en": "Stay out of my way!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.86",
   "en": "..."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.87",
   "en": "Fresh reinforcements!?"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.90",
   "en": "Kh! How dare you...!!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.91",
   "en": "Fall back, Altron. I'll handle the rest."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.92",
   "en": "..."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.96",
   "en": "Mission complete."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.101",
   "en": "Everyone!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.103",
   "en": "Looks like you're safe."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.104",
   "en": "Hey, you guys! I caught up with... huh?"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.105",
   "en": "What, looks like you didn't even need us to come."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.107",
   "en": "Still, trying to take on that many by yourself... You haven't changed a bit."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.108",
   "en": "I'm glad you're safe. It's been a long time, Altron."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.110",
   "en": "And you lot are as softhearted as ever, I see."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.111",
   "en": "...Altron. Do you still intend to act alone?"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.112",
   "en": "Of course. I act on my own convictions, nothing more."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.113",
   "en": "The battle in this world is already approaching its final stage."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.114",
   "en": "Altron, we want you to work with us too."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.116",
   "en": "You of all people should know just how powerful the evil in this world is."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.117",
   "en": "The righteous have to be strong, right?"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.118",
   "en": "Come with us, Altron!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.119",
   "en": "...Very well. If our goals are the same, I'll team up with you for now."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.120",
   "en": "But I have no intention of joining your ranks."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.121",
   "en": "Yeah. Understood."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.122",
   "en": "Thank you, Altron!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.125",
   "en": "Listen, we're in the right. I'll never accept this world. Whatever awaits, I'll defeat the foes I must!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.127",
   "en": "Obtained Altron Gundam's chip."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.128",
   "en": "Completed the quest \"Backing Up Altron\"."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.129",
   "en": "You can report quests in the Quest Room at the base."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.131",
   "en": "Are you an idiot!? We came all the way out here, so why isn't Wing Zero with us!!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.133",
   "en": "THIS IS BAD, ALL OF YOU! ALTRON IS IN DANGER!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.134",
   "en": "Pigmon, calm down!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.135",
   "en": "From what Pigmon says, it seems Altron is being attacked by a huge number of Gundams."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.136",
   "en": "I WAS INVESTIGATING THIS PLACE. THAT IS WHEN I FOUND ALTRON UNDER ATTACK."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.137",
   "en": "Then those \"Gundams\" must be..."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.138",
   "en": "Yes. There's no doubt they're Virgos."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.139",
   "en": "By the way, Pigmon, where did you see Altron?"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.140",
   "en": "THE PLACE I SAW ALTRON WAS THE ROOM WHERE VEDA IS."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.141",
   "en": "ALTRON WAS IN A CERTAIN ROOM IN VEDA."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.142",
   "en": "I see. Thank you for the information, Pigmon."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.143",
   "en": "Everyone, please. Go and rescue Altron."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.144",
   "en": "I AM COUNTING ON YOU!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.145",
   "en": "..."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.146",
   "en": "Haah!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.148",
   "en": "I don't care how many of you come!! Don't underestimate me!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.150",
   "en": "..."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.151",
   "en": "Enemy reinforcements!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.152",
   "en": "..."
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.154",
   "en": "Damn it! One after another!! Don't underestimate Nataku!"
  },
  {
   "key": "Table/Event/Quest/QuestEventMess021.mbb#0.156",
   "en": "Are you all right!?"
